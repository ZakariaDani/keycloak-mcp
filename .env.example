# Keycloak MCP server configuration
# Copy to .env and fill in real values. Do NOT commit .env.

# Base URL of the Keycloak server
KEYCLOAK_BASE_URL=http://localhost:8080

# Realm used to AUTHENTICATE the admin service account (not the target realm of operations)
KEYCLOAK_REALM=master

# Confidential client with service accounts enabled (client_credentials grant)
KEYCLOAK_CLIENT_ID=keycloak-mcp

# Service account client secret — keep out of version control
KEYCLOAK_CLIENT_SECRET=
